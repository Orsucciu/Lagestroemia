{
  "manifest_version": 3,
  "name": "Lagestroemia for chat.z.ai",
  "version": "0.5.3",
  "description": "A powerful chat client for chat.z.ai with auto-retry, model switching, and conversation management.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://chat.z.ai/*",
    "https://*.chat.z.ai/*",
    "https://o.alicdn.com/*"
  ],
  "action": {
    "default_title": "Open Lagestroemia",
    "default_popup": "sidepanel.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.z.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
