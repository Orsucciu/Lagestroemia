# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub/
build/
**/generated_plugin_registrant.dart

**/.symlinks/

# Flutter SDK local installs (we keep Flutter outside the repo).
# NOTE: the leading slash makes this match ONLY the root-level flutter/
# directory, NOT windows/flutter/ or other platform subdirectories
# which contain essential build files that MUST be committed.
/flutter/

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws
.DS_Store

# Generated
*.g.dart
*.freezed.dart

# OS files
Thumbs.db
.DS_Store
# Ephemeral dirs are generated by the Flutter build — but we DO need
# to commit windows/flutter/ and its CMakeLists.txt (which is NOT
# ephemeral). The ephemeral/ dir itself is auto-generated.
**/ephemeral/
e2e/test-results/
e2e/node_modules/
scripts/extension-chrome/
scripts/extension-firefox/
extension/__pycache__/
*.pyc
